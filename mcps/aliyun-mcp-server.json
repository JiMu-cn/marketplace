{
  "aliyun-mcp-server": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "aliyun-mcp-server"
    ],
    "env": {
      "ALIYUN_ACCESS_KEY_ID": "your-access-key-id",
      "ALIYUN_ACCESS_KEY_SECRET": "your-access-key-secret",
      "SLS_ENDPOINT": "cn-hangzhou.log.aliyuncs.com"
    }
  }
}
